# Workspace root ignores. Each package carries its own .gitignore for
# platform-specific artifacts.
.DS_Store
.dart_tool/
*.log
build/

# JetBrains IDE: run configurations are shared so a fresh clone brings the
# run scripts along; everything else under .idea/ is machine-specific and
# regenerated by the IDE on open.
.idea/*
!.idea/runConfigurations/
*.iml

# Claude Code personal settings (machine-local permissions), if created.
.claude/settings.local.json

# AI session scratch area — never committed; safe to delete at any time.
_to_delete/

# The workspace resolves dependencies at the root. Libraries do not commit
# lockfiles: https://dart.dev/guides/libraries/private-files#pubspeclock
/pubspec.lock
